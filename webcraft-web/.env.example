# Copy to .env and adjust. Never commit .env.

# Port of the web page on this machine
WC_HTTP_PORT=8080

# Where the WebCraft plugin listens (host:port, see plugins/WebCraft/config.yml)
WC_BACKEND=host.docker.internal:25007

# Address prefilled in the login form; empty = through this web server (/ws)
WC_SERVER=

# Name prefix of the plugin (plugins/WebCraft/config.yml name-prefix)
WC_NAME_PREFIX=wc_
